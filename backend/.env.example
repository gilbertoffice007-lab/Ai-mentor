# Application Configuration
APP_NAME="CareerPath AI Mentor Backend"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./careerpath.db
# Example PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# Google Gemini API Key for AI Career Mentor & ATS Resume Audits
GEMINI_API_KEY=

# Supabase (Optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
